{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@web/*": ["src/web/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  // `exclude` must be restated: it is not merged from the base config, and the
  // base excludes src/web to keep it out of the server build. Inheriting that
  // exclusion here silently reduced this project to src/shared only, so the
  // SPA went untypechecked.
  "exclude": ["dist/**", "node_modules/**"],
  "include": ["src/web/**/*", "src/shared/**/*"]
}
